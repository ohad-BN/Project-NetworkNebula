# ==============================================================================
# Project NetworkNebula — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your setup.
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://nebula_user:your_password_here@localhost:5433/nebula_db

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MinIO / S3 Compatible Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=nebula-datasets
MINIO_REGION=us-east-1

# Local Model Weights Cache Directory
MODEL_CACHE_DIR=./models/cache

# POC / Test Mode Acceleration (Set to true for rapid unit testing without downloading 15GB+ weights)
FAST_POC_MODE=true
