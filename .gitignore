# ==============================================================================
# Project NetworkNebula — Git Ignore Rules
# ==============================================================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.cert
*.secret

# Python artifacts & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Frontend dependencies & production builds
node_modules/
network-nebula/node_modules/
network-nebula/dist/
network-nebula/dist-ssr/
*.tsbuildinfo
test-results/
playwright-report/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI weights, model checkpoints, and datasets
data/
models/cache/
*.safetensors
*.pt
*.bin
*.onnx
*.ckpt
*.h5
*.arrow
*.parquet
*.jsonl

# Database & Celery runtime files
*.sqlite3
*.db
celerybeat-schedule
celerybeat.pid

# Logs & temp files
*.log
logs/
*.tmp
*.temp
nul

# IDE & OS metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Agent scratch & local run artifacts
.gemini/
scratch/
docs/temp/scratchpad/*
!docs/temp/scratchpad/.gitkeep
docs/temp/reports/*
!docs/temp/reports/.gitkeep

# Binaries, native libraries & tools
*.exe
*.dll
*.dylib
*.so
bin/
.bin/
cloudflared.exe

